{
  "name": "qa-job-hunter-automation",
  "version": "1.0.0",
  "description": "QA Job Hunting and Application Automation Tool with semantic form filling, match scoring, and CAPTCHA safety circuit breaker",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "keywords": [
    "qa",
    "sdet",
    "job-hunter",
    "automation",
    "playwright"
  ],
